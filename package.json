{
  "name": "copilot-engine",
  "version": "1.1.0",
  "description": "Reusable, LLM-agnostic backend for building AI copilots with agentic tool use, SSE streaming, and action approval workflows. Supports Anthropic Claude and OpenAI GPT.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./mount": {
      "types": "./dist/src/mount.d.ts",
      "default": "./dist/src/mount.js"
    },
    "./projects/aisoar/system-prompt": {
      "types": "./dist/projects/aisoar/system-prompt.d.ts",
      "default": "./dist/projects/aisoar/system-prompt.js"
    },
    "./projects/aisoar/tools": {
      "types": "./dist/projects/aisoar/tools.d.ts",
      "default": "./dist/projects/aisoar/tools.js"
    },
    "./projects/aisoar/tool-executor": {
      "types": "./dist/projects/aisoar/tool-executor.d.ts",
      "default": "./dist/projects/aisoar/tool-executor.js"
    },
    "./projects/aisoar/config": {
      "types": "./dist/projects/aisoar/config.d.ts",
      "default": "./dist/projects/aisoar/config.js"
    }
  },
  "author": "femitfash",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/femitfash/copilot-engine.git"
  },
  "homepage": "https://github.com/femitfash/copilot-engine#readme",
  "bugs": {
    "url": "https://github.com/femitfash/copilot-engine/issues"
  },
  "keywords": [
    "copilot",
    "claude",
    "anthropic",
    "openai",
    "gpt",
    "ai",
    "agentic",
    "sse",
    "streaming",
    "tool-use",
    "llm-agnostic"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "prestart": "npm run build",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.100.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "openai": "^6.33.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.12.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
